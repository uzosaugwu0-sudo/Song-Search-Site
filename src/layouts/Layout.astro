---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Search a song database by title or lyrics.' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700;800&display=swap" rel="stylesheet" />
  <style>
    :root {
      --color-primary: #7c3aed;
      --color-on-primary: #ffffff;
      --color-accent: #a16207;
      --color-background: #faf5ff;
      --color-foreground: #4c1d95;
      --color-card: #ffffff;
      --color-card-foreground: #4c1d95;
      --color-muted: #ece0f9;
      --color-muted-foreground: #6b5c8a;
      --color-border: #ddd6fe;
      color-scheme: light dark;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --color-primary: #a78bfa;
        --color-on-primary: #1e1b2e;
        --color-accent: #fbbf24;
        --color-background: #1e1b2e;
        --color-foreground: #ede9fe;
        --color-card: #2a2438;
        --color-card-foreground: #ede9fe;
        --color-muted: #332c47;
        --color-muted-foreground: #b8b0d9;
        --color-border: #45395c;
      }
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--color-background);
      color: var(--color-foreground);
      font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
      line-height: 1.6;
    }
    h1 {
      font-family: 'Playfair Display', Georgia, serif;
      font-weight: 800;
      margin: 0 0 8px;
    }
    a { color: var(--color-primary); }
    button { font-family: inherit; }
    .container {
      max-width: 680px;
      margin: 0 auto;
      padding: 32px 20px 64px;
    }
  </style>
</head>
<body>
  <div class="container">
    <slot />
  </div>
</body>
</html>
