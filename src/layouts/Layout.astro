---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Search a song database by title or lyrics.' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Cormorant+Garamond:wght@600;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --color-primary: #7a6a3d;
      --color-on-primary: #ffffff;
      --color-accent: #7a6a3d;
      --color-background: #e5e5e5;
      --color-foreground: #1b2a4a;
      --color-card: #ffffff;
      --color-card-foreground: #1b2a4a;
      --color-muted: #f0f0f0;
      --color-muted-foreground: #5f6360;
      --color-border: #d8d8d8;
      color-scheme: light dark;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --color-primary: #c9b26b;
        --color-on-primary: #1b2a4a;
        --color-accent: #c9b26b;
        --color-background: #14192b;
        --color-foreground: #e8e6df;
        --color-card: #1e2740;
        --color-card-foreground: #e8e6df;
        --color-muted: #262f4a;
        --color-muted-foreground: #a3a7b8;
        --color-border: #333e5c;
      }
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--color-background);
      color: var(--color-foreground);
      font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
      line-height: 1.6;
    }
    h1 {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-weight: 700;
      margin: 0 0 8px;
    }
    a { color: var(--color-primary); }
    button { font-family: inherit; }
    .container {
      max-width: 680px;
      margin: 0 auto;
      padding: 32px 20px 64px;
    }
  </style>
</head>
<body>
  <div class="container">
    <slot />
  </div>
</body>
</html>
