---
import Layout from '../layouts/Layout.astro';
import { loadSongs } from '../lib/songs-data.js';
import { findDuplicateGroups } from '../lib/duplicate-groups.js';

export const prerender = false;

const songs = await loadSongs(Astro.locals.runtime.env.SONGS_DATA);
const duplicateGroups = findDuplicateGroups(songs);
const totalDuplicateSongs = duplicateGroups.reduce((sum, group) => sum + group.length, 0);
---
<Layout title="Possible Duplicate Songs — Song Search" description="A maintenance report of songs that may be duplicates.">
  <div class="page">
    <p><a href="/">← Back to search</a></p>
    <h1>Possible Duplicate Songs</h1>
    <p class="intro">
      Songs whose titles match once case, punctuation, and spacing are ignored. This
      won't catch every duplicate — "Amazing Grace" and "Amazing Grace 2" are treated
      as different titles — but it's a good starting point for cleaning up the song
      database.
    </p>

    {duplicateGroups.length === 0 ? (
      <p class="status">No possible duplicates found.</p>
    ) : (
      <>
        <p class="status">
          Found {duplicateGroups.length} possible duplicate group{duplicateGroups.length === 1 ? '' : 's'},
          covering {totalDuplicateSongs} songs.
        </p>
        <ul class="groups">
          {duplicateGroups.map((group) => (
            <li class="group">
              <h2>{group.length} songs with matching titles</h2>
              <ul class="group-songs">
                {group.map((song) => (
                  <li>
                    <a href={`/song/${song.slug}/`}>{song.title}</a>
                    {song.author && <span class="author"> — {song.author}</span>}
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
      </>
    )}
  </div>

  <style>
    .page {
      max-width: 680px;
      margin: 0 auto;
    }
    .intro {
      color: var(--color-muted-foreground);
      margin: 0 0 20px;
    }
    .status {
      color: var(--color-muted-foreground);
      margin-bottom: 24px;
    }
    .groups {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .group {
      padding: 20px;
      border: 1px solid var(--color-border);
      border-radius: 16px;
      background: var(--color-card);
      box-shadow: var(--shadow-card);
    }
    .group h2 {
      font-size: 1rem;
      margin: 0 0 10px;
    }
    .group-songs {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .group-songs a {
      font-weight: 600;
      text-decoration: none;
    }
    .group-songs a:hover {
      text-decoration: underline;
    }
    .author {
      color: var(--color-muted-foreground);
      font-size: 0.9rem;
    }
  </style>
</Layout>
