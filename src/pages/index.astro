---
import Layout from '../layouts/Layout.astro';
import songs from '../data/songs.json';

const songsJson = JSON.stringify(songs).replace(/</g, '\\u003c');
---
<Layout title="Wisdom Assembly Song Search">
  <h1>Wisdom Assembly Song Search</h1>
  <input type="search" id="search" placeholder="Search by title or lyrics..." autofocus />
  <p class="hint">Try a phrase from the lyrics, or the title.</p>
  <p id="status"></p>
  <ul id="results"></ul>

  <style is:global>
    #search {
      width: 100%;
      padding: 16px 20px;
      font-size: 1.05rem;
      border: 1px solid var(--color-border);
      border-radius: 14px;
      background: var(--color-card);
      color: var(--color-card-foreground);
      box-shadow: var(--shadow-card);
    }
    #search:focus {
      outline: 2px solid var(--color-primary);
      outline-offset: 1px;
    }
    .hint {
      color: var(--color-muted-foreground);
      font-size: 0.9rem;
      margin: 8px 0 0;
    }
    #status {
      color: var(--color-muted-foreground);
      margin-top: 16px;
    }
    #results {
      list-style: none;
      margin: 24px 0 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 16px;
    }
    .result-card {
      display: block;
      padding: 20px;
      border: 1px solid var(--color-border);
      border-radius: 16px;
      background: var(--color-card);
      color: var(--color-card-foreground);
      text-decoration: none;
      box-shadow: var(--shadow-card);
      transition: transform 150ms ease, box-shadow 150ms ease;
    }
    .result-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 2px 4px rgba(26, 26, 46, 0.08), 0 12px 28px rgba(26, 26, 46, 0.1);
    }
    .result-title {
      font-family: 'Sora', ui-sans-serif, system-ui, sans-serif;
      font-size: 1.1rem;
      font-weight: 700;
    }
    .result-author { color: var(--color-muted-foreground); font-size: 0.9rem; }
    .result-snippet {
      margin-top: 6px;
      font-size: 0.9rem;
      color: var(--color-muted-foreground);
    }
    .result-snippet mark {
      background: var(--color-primary);
      color: var(--color-on-primary);
      font-weight: 600;
      padding: 1px 4px;
      border-radius: 3px;
    }
  </style>

  <script type="application/json" id="songs-data" set:html={songsJson} />
  <script>
    const data = JSON.parse(document.getElementById('songs-data').textContent);
    const input = document.getElementById('search');
    const results = document.getElementById('results');
    const status = document.getElementById('status');

    function snippetParts(lyrics, q) {
      const idx = lyrics.toLowerCase().indexOf(q);
      if (idx === -1) return null;
      const start = Math.max(0, idx - 30);
      const end = Math.min(lyrics.length, idx + q.length + 50);
      return {
        before: (start > 0 ? '…' : '') + lyrics.slice(start, idx).replace(/\s+/g, ' '),
        match: lyrics.slice(idx, idx + q.length),
        after: lyrics.slice(idx + q.length, end).replace(/\s+/g, ' ') + (end < lyrics.length ? '…' : ''),
      };
    }

    function render(query, { updateUrl = true } = {}) {
      results.innerHTML = '';

      if (updateUrl) {
        const url = query ? `?q=${encodeURIComponent(query)}` : location.pathname;
        history.replaceState(null, '', url);
      }

      if (!query) {
        const link = document.createElement('a');
        link.href = '/browse/1/';
        link.textContent = `Browse all ${data.length} songs →`;
        status.replaceChildren(link);
        return;
      }

      const q = query.toLowerCase();
      const matches = data.filter((song) => song.title.toLowerCase().includes(q) || song.lyrics.toLowerCase().includes(q));

      status.textContent = matches.length > 0
        ? `${matches.length} song${matches.length === 1 ? '' : 's'} found`
        : 'No songs found. Try checking your spelling or using fewer words.';

      for (const song of matches) {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.className = 'result-card';
        a.href = `/song/${song.slug}/?q=${encodeURIComponent(query)}`;

        const title = document.createElement('div');
        title.className = 'result-title';
        title.textContent = song.title;
        a.appendChild(title);

        const parts = query ? snippetParts(song.lyrics, q) : null;
        if (parts) {
          const snipEl = document.createElement('div');
          snipEl.className = 'result-snippet';
          snipEl.appendChild(document.createTextNode(parts.before));
          const mark = document.createElement('mark');
          mark.textContent = parts.match;
          snipEl.appendChild(mark);
          snipEl.appendChild(document.createTextNode(parts.after));
          a.appendChild(snipEl);
        } else if (song.author) {
          const author = document.createElement('div');
          author.className = 'result-author';
          author.textContent = song.author;
          a.appendChild(author);
        }

        li.appendChild(a);
        results.appendChild(li);
      }
    }

    input.addEventListener('input', (e) => render(e.target.value));

    const initialQuery = new URLSearchParams(location.search).get('q') || '';
    input.value = initialQuery;
    render(initialQuery, { updateUrl: false });
  </script>
</Layout>
