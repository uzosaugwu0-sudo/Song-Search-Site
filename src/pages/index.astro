---
import Layout from '../layouts/Layout.astro';
import { loadSongs } from '../lib/songs-data.js';

export const prerender = false;

const songs = await loadSongs(Astro.locals.runtime.env.SONGS_DATA);
const songsJson = JSON.stringify(songs).replace(/</g, '\\u003c');
---
<Layout title="Wisdom Assembly Song Search">
  <h1>Wisdom Assembly Song Search</h1>
  <div class="search-field">
    <svg class="search-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
    <input type="search" id="search" class="input" placeholder="Search by title or lyrics..." autofocus />
  </div>
  <p class="hint">Try a phrase from the lyrics, or the title.</p>

  <div id="tabs">
    <button type="button" class="tab active" data-tab="all">All Songs</button>
    <button type="button" class="tab" data-tab="favorites">Favorites</button>
    <button type="button" class="tab" data-tab="recent">Recently Viewed</button>
    <button type="button" class="tab" data-tab="set">Service List</button>
  </div>

  <p id="status"></p>
  <ul id="results"></ul>
  <nav id="pagination"></nav>

  <style is:global>
    .search-field { position: relative; }
    .search-field .search-icon {
      position: absolute;
      left: var(--space-4);
      top: 50%;
      transform: translateY(-50%);
      color: var(--color-muted-foreground);
      pointer-events: none;
    }
    .search-field .input {
      padding-left: calc(var(--space-4) + 28px);
      min-height: 52px;
      font-size: var(--text-lg);
      box-shadow: var(--shadow-card);
    }
    .hint {
      color: var(--color-muted-foreground);
      font-size: var(--text-sm);
      margin: var(--space-2) 0 0;
    }
    #status {
      color: var(--color-muted-foreground);
      margin-top: var(--space-4);
    }
    #tabs {
      display: flex;
      gap: var(--space-5);
      margin-top: var(--space-5);
      border-bottom: 1px solid var(--color-border);
      overflow-x: auto;
    }
    .tab {
      appearance: none;
      background: none;
      border: none;
      border-bottom: 3px solid transparent;
      margin-bottom: -1px;
      padding: var(--space-3) 0;
      font-family: inherit;
      font-size: var(--text-sm);
      font-weight: 600;
      white-space: nowrap;
      color: var(--color-muted-foreground);
    }
    .tab:hover { color: var(--color-foreground); }
    .tab.active {
      color: var(--color-foreground);
      border-bottom-color: var(--color-accent);
    }
    #results {
      list-style: none;
      margin: var(--space-5) 0 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: var(--space-4);
    }
    .result-item { position: relative; }
    .add-to-set-btn {
      position: absolute;
      top: var(--space-3);
      right: var(--space-3);
      color: var(--color-primary);
      font-size: 1.1rem;
      line-height: 1;
    }
    .draft-group, .date-group { grid-column: 1 / -1; list-style: none; }
    .draft-group > details > summary, .date-group > details > summary {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      list-style: none;
      cursor: pointer;
    }
    .draft-group > details > summary > .set-section-row { flex: 1; }
    .draft-group > details > summary::-webkit-details-marker,
    .date-group > details > summary::-webkit-details-marker { display: none; }
    .draft-group > details > summary::before,
    .date-group > details > summary::before { content: '▸'; color: var(--color-muted-foreground); }
    .draft-group > details[open] > summary::before,
    .date-group > details[open] > summary::before { content: '▾'; }
    .date-group > details > summary {
      padding: var(--space-3) var(--space-4);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-control);
      background: var(--color-card);
      font-weight: 600;
    }
    .group-songs {
      list-style: none;
      margin: var(--space-2) 0 0;
      padding: 0 0 0 var(--space-4);
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }
    .set-controls {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3);
      align-items: center;
      grid-column: 1 / -1;
    }
    .set-controls .row-title { flex: 1 1 auto; }
    .playlist-section-label {
      grid-column: 1 / -1;
      margin: var(--space-4) 0 calc(-1 * var(--space-2));
    }
    .playlist-name-input { flex: 1; min-width: 200px; width: auto; }
    .set-song-row { grid-column: 1 / -1; }
    .set-section-row { font-weight: 700; border-bottom: 2px solid var(--color-border-strong); }
    .result-card {
      display: block;
      padding: var(--space-4) calc(var(--control-height-compact) + var(--space-6)) var(--space-4) var(--space-5);
      color: var(--color-card-foreground);
      text-decoration: none;
      transition: border-color 150ms ease, box-shadow 150ms ease;
    }
    .result-card:hover { border-color: var(--color-primary); box-shadow: var(--shadow-raised); }
    .result-card.selected { outline: var(--focus-ring); outline-offset: 2px; }
    .result-title { font-size: var(--text-lg); font-weight: 700; overflow-wrap: anywhere; }
    .result-author { color: var(--color-muted-foreground); font-size: var(--text-sm); }
    .result-snippet {
      margin-top: var(--space-2);
      font-size: var(--text-sm);
      color: var(--color-muted-foreground);
    }
    .result-snippet mark {
      background: var(--color-primary);
      color: var(--color-on-primary);
      font-weight: 600;
      padding: 1px var(--space-1);
      border-radius: var(--space-1);
    }
    #pagination {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: var(--space-6);
      gap: var(--space-4);
    }
    #pagination .page-count {
      color: var(--color-muted-foreground);
      font-size: var(--text-sm);
    }
  </style>

  <script type="application/json" id="songs-data" set:html={songsJson} />
  <script>
    import { normalizeTitle } from '../lib/normalize.js';
    import { isHeading, addHeading, renameHeading, removeAt, moveItem, groupBySection } from '../lib/sections.js';
    import { askSectionName, confirmDialog } from '../lib/dialogs.js';
    import { formatListDate, groupListsByDay } from '../lib/setlist.js';
    import { addToDraft, removeFromDraft, reorderInDraft, getDraftIds, getPlaylists, removePlaylistFromLibrary, saveDraftAsPlaylist, listSetlists, deleteSetlist, updateDraft } from '../lib/setlist-client.js';

    const data = JSON.parse(document.getElementById('songs-data').textContent);
    const input = document.getElementById('search');
    const results = document.getElementById('results');
    const status = document.getElementById('status');
    const pagination = document.getElementById('pagination');

    const PAGE_SIZE = 50;
    const sorted = [...data].sort((a, b) => a.title.localeCompare(b.title));
    const totalPages = Math.max(1, Math.ceil(sorted.length / PAGE_SIZE));
    const songById = new Map(data.map((song) => [song.id, song]));

    const tabs = document.getElementById('tabs');
    const tabButtons = Array.from(tabs.querySelectorAll('.tab'));
    let currentTab = 'all';
    let selectedIndex = -1;
    let cachedPlaylists = [];
    let publicLists = [];
    let publicListsLoaded = false;
    // Open/closed state of drop-downs, kept across re-renders.
    // ponytail: draft sections are remembered by name, so duplicate names share a state.
    const closedDraftSections = new Set();
    const dateOpenState = new Map();
    // Local changes KV's eventual consistency may not show yet (up to ~60s).
    const justCreated = new Map();
    const justDeleted = new Set();
    const PUBLIC_REFRESH_MS = 30000;
    let draftNameValue = '';

    function getFavorites() {
      try { return JSON.parse(localStorage.getItem('songSearchFavorites') || '[]'); }
      catch { return []; }
    }
    function getRecent() {
      try { return JSON.parse(localStorage.getItem('songSearchRecent') || '[]'); }
      catch { return []; }
    }
    function setFavorites(ids) {
      try { localStorage.setItem('songSearchFavorites', JSON.stringify(ids)); } catch {}
    }

    function updateTabLabels() {
      const favCount = getFavorites().length;
      const recentCount = getRecent().length;
      const playlistCount = cachedPlaylists.length;
      for (const btn of tabButtons) {
        const type = btn.dataset.tab;
        const label = type === 'all' ? 'All Songs'
          : type === 'favorites' ? 'Favorites'
          : type === 'recent' ? 'Recently Viewed'
          : 'Service List';
        const count = type === 'favorites' ? favCount
          : type === 'recent' ? recentCount
          : type === 'set' ? playlistCount
          : null;
        btn.textContent = count ? `${label} (${count})` : label;
      }
    }

    function showTabs() {
      tabs.style.display = 'flex';
    }

    function markActiveTab(tab) {
      for (const btn of tabButtons) btn.classList.toggle('active', btn.dataset.tab === tab);
    }

    function renderFavoritesTab() {
      showTabs();
      pagination.style.display = 'none';
      results.replaceChildren();
      selectedIndex = -1;
      const favSongs = getFavorites().map((id) => songById.get(id)).filter(Boolean);
      if (favSongs.length === 0) {
        status.textContent = 'No favorites yet — tap the star on a song page to add one.';
        return;
      }
      status.textContent = `${favSongs.length} favorite song${favSongs.length === 1 ? '' : 's'}`;
      for (const song of favSongs) results.appendChild(buildCard(song, '', 1, 'favorites'));
    }

    function renderRecentTab() {
      showTabs();
      pagination.style.display = 'none';
      results.replaceChildren();
      selectedIndex = -1;
      const recentSongs = getRecent().map((id) => songById.get(id)).filter(Boolean);
      if (recentSongs.length === 0) {
        status.textContent = 'No recently viewed songs yet.';
        return;
      }
      status.textContent = `${recentSongs.length} recently viewed song${recentSongs.length === 1 ? '' : 's'}`;
      for (const song of recentSongs) results.appendChild(buildCard(song, '', 1, 'recent'));
    }

    function buildPlaylistSongRow(song, { showUp, showDown, onUp, onDown, onRemove }) {
      const li = document.createElement('li');
      li.className = 'set-song-row row';

      const link = document.createElement('a');
      link.className = 'row-title';
      link.href = `/song/${song.slug}/?from=set`;
      link.textContent = song.title;
      li.appendChild(link);

      if (song.author) {
        const author = document.createElement('span');
        author.className = 'result-author';
        author.textContent = song.author;
        li.appendChild(author);
      }

      const controls = document.createElement('span');
      controls.className = 'row-controls';

      const upBtn = document.createElement('button');
      upBtn.type = 'button';
      upBtn.className = 'btn btn-sm';
      upBtn.textContent = '↑';
      upBtn.disabled = !showUp;
      upBtn.addEventListener('click', onUp);
      controls.appendChild(upBtn);

      const downBtn = document.createElement('button');
      downBtn.type = 'button';
      downBtn.className = 'btn btn-sm';
      downBtn.textContent = '↓';
      downBtn.disabled = !showDown;
      downBtn.addEventListener('click', onDown);
      controls.appendChild(downBtn);

      const removeBtn = document.createElement('button');
      removeBtn.type = 'button';
      removeBtn.className = 'btn btn-sm btn-danger';
      removeBtn.textContent = 'Remove';
      removeBtn.addEventListener('click', onRemove);
      controls.appendChild(removeBtn);

      li.appendChild(controls);
      return li;
    }

    function buildDraftHeadingRow(heading, index, total, songCount) {
      const li = document.createElement('div');
      li.className = 'set-song-row set-section-row row';

      const title = document.createElement('span');
      title.textContent = `${heading.section} (${songCount})`;
      li.appendChild(title);

      const controls = document.createElement('span');
      controls.className = 'row-controls';

      const upBtn = document.createElement('button');
      upBtn.type = 'button';
      upBtn.className = 'btn btn-sm';
      upBtn.textContent = '↑';
      upBtn.disabled = index === 0;
      upBtn.addEventListener('click', () => { updateDraft((items) => moveItem(items, index, -1)); renderPlaylistsTab(); });
      controls.appendChild(upBtn);

      const downBtn = document.createElement('button');
      downBtn.type = 'button';
      downBtn.className = 'btn btn-sm';
      downBtn.textContent = '↓';
      downBtn.disabled = index === total - 1;
      downBtn.addEventListener('click', () => { updateDraft((items) => moveItem(items, index, 1)); renderPlaylistsTab(); });
      controls.appendChild(downBtn);

      const renameBtn = document.createElement('button');
      renameBtn.type = 'button';
      renameBtn.className = 'btn btn-sm';
      renameBtn.textContent = 'Rename';
      renameBtn.addEventListener('click', async () => {
        const name = await askSectionName(heading.section);
        if (!name) return;
        updateDraft((items) => renameHeading(items, index, name));
        renderPlaylistsTab();
      });
      controls.appendChild(renameBtn);

      const removeBtn = document.createElement('button');
      removeBtn.type = 'button';
      removeBtn.className = 'btn btn-sm btn-danger';
      removeBtn.textContent = 'Remove';
      removeBtn.addEventListener('click', () => { updateDraft((items) => removeAt(items, index)); renderPlaylistsTab(); });
      controls.appendChild(removeBtn);

      li.appendChild(controls);
      return li;
    }

    // A draft section header (click to open/close) with its songs underneath.
    function buildDraftSection(group, rows, total) {
      const name = group.heading.section;
      const li = document.createElement('li');
      li.className = 'draft-group';

      const details = document.createElement('details');
      details.open = !closedDraftSections.has(name);
      details.addEventListener('toggle', () => {
        if (details.open) closedDraftSections.delete(name);
        else closedDraftSections.add(name);
      });

      const summary = document.createElement('summary');
      summary.appendChild(buildDraftHeadingRow(group.heading, group.headingIndex, total, rows.length));
      details.appendChild(summary);

      const songs = document.createElement('ul');
      songs.className = 'group-songs';
      rows.forEach((row) => songs.appendChild(row));
      details.appendChild(songs);

      li.appendChild(details);
      return li;
    }

    function buildPublicListRow(list) {
      const li = document.createElement('li');
      li.className = 'set-controls row';

      const link = document.createElement('a');
      link.className = 'row-title';
      link.href = `/set/${list.id}/`;
      link.textContent = `${list.name} (${list.count} song${list.count === 1 ? '' : 's'})`;
      li.appendChild(link);

      const deleteBtn = document.createElement('button');
      deleteBtn.type = 'button';
      deleteBtn.className = 'btn btn-sm btn-danger';
      deleteBtn.textContent = 'Delete';
      deleteBtn.addEventListener('click', async () => {
        if (!(await confirmDialog(`Delete "${list.name}" for everyone? This can't be undone from the site.`, { confirmLabel: 'Delete', danger: true }))) return;
        try {
          await deleteSetlist(list.id);
          removePlaylistFromLibrary(list.id);
          justDeleted.add(list.id);
          justCreated.delete(list.id);
          publicLists = publicLists.filter((l) => l.id !== list.id);
          renderPlaylistsTab();
        } catch (err) {
          showTransientStatus(err.message);
        }
      });
      li.appendChild(deleteBtn);
      return li;
    }

    // One click-to-open header per day, so lists made on the same day stay together.
    // Today starts open; other days start closed until the viewer opens them.
    function buildDateGroup(group) {
      const li = document.createElement('li');
      li.className = 'date-group';

      const details = document.createElement('details');
      details.open = dateOpenState.has(group.key) ? dateOpenState.get(group.key) : group.isToday;
      details.addEventListener('toggle', () => dateOpenState.set(group.key, details.open));

      const summary = document.createElement('summary');
      summary.textContent = `${group.label} · ${group.lists.length} list${group.lists.length === 1 ? '' : 's'}`;
      details.appendChild(summary);

      const lists = document.createElement('ul');
      lists.className = 'group-songs';
      group.lists.forEach((list) => lists.appendChild(buildPublicListRow(list)));
      details.appendChild(lists);

      li.appendChild(details);
      return li;
    }

    function renderPlaylistsTab() {
      showTabs();
      pagination.style.display = 'none';
      results.replaceChildren();
      selectedIndex = -1;

      cachedPlaylists = getPlaylists();
      updateTabLabels();

      const draftIds = getDraftIds();
      const draftSongs = draftIds.map((id) => songById.get(id)).filter(Boolean);

      if (draftSongs.length === 0 && cachedPlaylists.length === 0) {
        status.textContent = 'No songs in your draft yet — use the + button on any song to add one.';
      } else {
        status.textContent = `${draftSongs.length} song${draftSongs.length === 1 ? '' : 's'} in your current draft`;
      }

      const buildingLabel = document.createElement('li');
      buildingLabel.className = 'playlist-section-label section-label';
      buildingLabel.textContent = 'Currently building';
      results.appendChild(buildingLabel);

      const controlsLi = document.createElement('li');
      controlsLi.className = 'set-controls row';

      const nameInput = document.createElement('input');
      nameInput.type = 'text';
      nameInput.placeholder = 'Name this service list (e.g. Sunday Service — Sept 28)';
      nameInput.className = 'playlist-name-input input';
      nameInput.maxLength = 100;
      nameInput.value = draftNameValue;

      const saveBtn = document.createElement('button');
      saveBtn.type = 'button';
      saveBtn.className = 'btn btn-primary';
      saveBtn.textContent = 'Save';

      function updateSaveDisabled() {
        saveBtn.disabled = draftSongs.length === 0 || nameInput.value.trim().length === 0;
      }
      updateSaveDisabled();

      nameInput.addEventListener('input', () => {
        draftNameValue = nameInput.value;
        updateSaveDisabled();
      });

      saveBtn.addEventListener('click', async () => {
        saveBtn.disabled = true;
        try {
          const savedName = nameInput.value.trim();
          const savedCount = draftSongs.length;
          const savedId = await saveDraftAsPlaylist(savedName);
          const savedAt = new Date().toISOString();
          justCreated.set(savedId, { id: savedId, name: savedName, count: savedCount, createdAt: savedAt, updatedAt: savedAt });
          publicLists = [justCreated.get(savedId), ...publicLists];
          draftNameValue = '';
          renderPlaylistsTab();
        } catch (err) {
          updateSaveDisabled();
          showTransientStatus(err.message || 'Could not save this service list — check your connection and try again.');
        }
      });

      const addSectionBtn = document.createElement('button');
      addSectionBtn.type = 'button';
      addSectionBtn.className = 'btn';
      addSectionBtn.textContent = 'Add section';
      addSectionBtn.addEventListener('click', async () => {
        const name = await askSectionName();
        if (!name) return;
        updateDraft((items) => addHeading(items, name));
        renderPlaylistsTab();
      });

      controlsLi.appendChild(nameInput);
      controlsLi.appendChild(addSectionBtn);
      controlsLi.appendChild(saveBtn);
      results.appendChild(controlsLi);

      for (const group of groupBySection(draftIds)) {
        const rows = group.entries.map(({ item, index }) => {
          const song = songById.get(item);
          if (!song) return null;
          return buildPlaylistSongRow(song, {
            showUp: index > 0,
            showDown: index < draftIds.length - 1,
            onUp: () => { reorderInDraft(song.id, -1); renderPlaylistsTab(); },
            onDown: () => { reorderInDraft(song.id, 1); renderPlaylistsTab(); },
            onRemove: () => { removeFromDraft(song.id); renderPlaylistsTab(); },
          });
        }).filter(Boolean);
        if (!group.heading) {
          rows.forEach((row) => results.appendChild(row));
        } else {
          results.appendChild(buildDraftSection(group, rows, draftIds.length));
        }
      }

      const libraryLabel = document.createElement('li');
      libraryLabel.className = 'playlist-section-label section-label';
      libraryLabel.textContent = 'Your Service Lists';
      results.appendChild(libraryLabel);

      if (cachedPlaylists.length === 0) {
        const emptyLi = document.createElement('li');
        emptyLi.className = 'set-controls';
        emptyLi.textContent = "You haven't saved any service lists yet.";
        results.appendChild(emptyLi);
      } else {
        for (const playlist of cachedPlaylists) {
          const li = document.createElement('li');
          li.className = 'set-controls row';

          const link = document.createElement('a');
          link.className = 'row-title';
          link.href = `/set/${playlist.id}/`;
          link.textContent = playlist.name;
          li.appendChild(link);

          const playlistDate = formatListDate(publicLists.find((l) => l.id === playlist.id)?.createdAt);
          if (playlistDate) {
            const dateBadge = document.createElement('span');
            dateBadge.className = 'badge';
            dateBadge.textContent = playlistDate;
            li.appendChild(dateBadge);
          }

          const removeBtn = document.createElement('button');
          removeBtn.type = 'button';
          removeBtn.className = 'btn btn-sm';
          removeBtn.textContent = 'Forget';
          removeBtn.addEventListener('click', () => {
            removePlaylistFromLibrary(playlist.id);
            renderPlaylistsTab();
          });
          li.appendChild(removeBtn);

          results.appendChild(li);
        }
      }

      const publicLabel = document.createElement('li');
      publicLabel.className = 'playlist-section-label section-label';
      publicLabel.textContent = 'All Service Lists';
      results.appendChild(publicLabel);

      if (publicLists.length === 0) {
        const emptyLi = document.createElement('li');
        emptyLi.className = 'set-controls';
        emptyLi.textContent = publicListsLoaded ? 'No service lists have been saved yet.' : 'Loading…';
        results.appendChild(emptyLi);
      }
      for (const group of groupListsByDay(publicLists)) {
        results.appendChild(buildDateGroup(group));
      }
    }

    // Refresh the public listing, merging in local changes the server hasn't
    // caught up with, and redraw only if something changed (so typing a list
    // name isn't interrupted by a background refresh).
    async function loadPublicLists({ quiet = false } = {}) {
      let fetched;
      try { fetched = await listSetlists(); }
      catch (err) {
        if (!quiet) showTransientStatus(err.message);
        publicListsLoaded = true;
        if (currentTab === 'set' && !input.value) renderPlaylistsTab();
        return;
      }
      const fetchedIds = new Set(fetched.map((l) => l.id));
      for (const id of fetchedIds) justCreated.delete(id);
      for (const id of justDeleted) if (!fetchedIds.has(id)) justDeleted.delete(id);
      const next = [...justCreated.values(), ...fetched.filter((l) => !justDeleted.has(l.id))];
      const changed = !publicListsLoaded || JSON.stringify(next) !== JSON.stringify(publicLists);
      publicLists = next;
      publicListsLoaded = true;
      if (changed && currentTab === 'set' && !input.value) renderPlaylistsTab();
    }

    function refreshPublicListsIfVisible() {
      if (currentTab === 'set' && !document.hidden) loadPublicLists({ quiet: true });
    }
    setInterval(refreshPublicListsIfVisible, PUBLIC_REFRESH_MS);
    document.addEventListener('visibilitychange', refreshPublicListsIfVisible);

    function renderCurrentTab() {
      if (currentTab === 'favorites') renderFavoritesTab();
      else if (currentTab === 'recent') renderRecentTab();
      else if (currentTab === 'set') { renderPlaylistsTab(); loadPublicLists(); }
      else renderBrowse(1);
    }

    function switchTab(tab) {
      if (input.value) {
        input.value = '';
        history.replaceState(null, '', location.pathname);
      }
      currentTab = tab;
      markActiveTab(tab);
      renderCurrentTab();
    }

    for (const btn of tabButtons) {
      btn.addEventListener('click', () => switchTab(btn.dataset.tab));
    }

    function levenshtein(a, b) {
      const rows = a.length + 1;
      const cols = b.length + 1;
      const dist = Array.from({ length: rows }, (_, i) => [i, ...Array(cols - 1).fill(0)]);
      for (let j = 0; j < cols; j++) dist[0][j] = j;
      for (let i = 1; i < rows; i++) {
        for (let j = 1; j < cols; j++) {
          const cost = a[i - 1] === b[j - 1] ? 0 : 1;
          dist[i][j] = Math.min(
            dist[i - 1][j] + 1,
            dist[i][j - 1] + 1,
            dist[i - 1][j - 1] + cost,
          );
        }
      }
      return dist[rows - 1][cols - 1];
    }

    function fuzzyThreshold(len) {
      if (len <= 4) return 1;
      if (len <= 8) return 2;
      return Math.floor(len * 0.3);
    }

    function fuzzyTitleMatches(query) {
      const nq = normalizeTitle(query);
      if (nq.length < 3) return [];
      const singleWord = !nq.includes(' ');
      const scored = [];
      for (const song of data) {
        const nt = normalizeTitle(song.title);
        let best = levenshtein(nq, nt);
        if (singleWord) {
          for (const word of nt.split(' ')) {
            const d = levenshtein(nq, word);
            if (d < best) best = d;
          }
        }
        if (best <= fuzzyThreshold(Math.min(nq.length, nt.length))) {
          scored.push({ song, dist: best });
        }
      }
      scored.sort((a, b) => a.dist - b.dist);
      return scored.slice(0, 8).map((s) => s.song);
    }

    function snippetParts(lyrics, q) {
      const idx = lyrics.toLowerCase().indexOf(q);
      if (idx === -1) return null;
      const start = Math.max(0, idx - 30);
      const end = Math.min(lyrics.length, idx + q.length + 50);
      return {
        before: (start > 0 ? '…' : '') + lyrics.slice(start, idx).replace(/\s+/g, ' '),
        match: lyrics.slice(idx, idx + q.length),
        after: lyrics.slice(idx + q.length, end).replace(/\s+/g, ' ') + (end < lyrics.length ? '…' : ''),
      };
    }

    function buildCard(song, query, page, from) {
      const li = document.createElement('li');
      li.className = 'result-item';
      li.dataset.songId = song.id;
      const a = document.createElement('a');
      a.className = 'card result-card';
      a.href = from
        ? `/song/${song.slug}/?from=${from}`
        : query
          ? `/song/${song.slug}/?q=${encodeURIComponent(query)}`
          : `/song/${song.slug}/${page > 1 ? `?page=${page}` : ''}`;

      const title = document.createElement('div');
      title.className = 'result-title';
      title.textContent = song.title;
      a.appendChild(title);

      const parts = query ? snippetParts(song.lyrics, query.toLowerCase()) : null;
      if (parts) {
        const snipEl = document.createElement('div');
        snipEl.className = 'result-snippet';
        snipEl.appendChild(document.createTextNode(parts.before));
        const mark = document.createElement('mark');
        mark.textContent = parts.match;
        snipEl.appendChild(mark);
        snipEl.appendChild(document.createTextNode(parts.after));
        a.appendChild(snipEl);
      } else if (song.author) {
        const author = document.createElement('div');
        author.className = 'result-author';
        author.textContent = song.author;
        a.appendChild(author);
      }

      li.appendChild(a);

      const addBtn = document.createElement('button');
      addBtn.type = 'button';
      addBtn.className = 'btn btn-icon btn-sm add-to-set-btn';
      addBtn.title = 'Add to list';
      addBtn.textContent = '+';
      addBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        addToDraft(song.id);
        // The song lands in the last section; make sure it is open so the song is visible.
        const lastDraftHeading = [...getDraftIds()].reverse().find(isHeading);
        if (lastDraftHeading) closedDraftSections.delete(lastDraftHeading.section);
        showTransientStatus(`Added "${song.title}" to your draft`);
        if (currentTab === 'set') renderPlaylistsTab();
      });
      li.appendChild(addBtn);

      return li;
    }

    function renderPagination(page) {
      pagination.replaceChildren();

      if (page > 1) {
        const prev = document.createElement('a');
        prev.className = 'btn';
        prev.href = '#';
        prev.textContent = '← Prev';
        prev.addEventListener('click', (e) => { e.preventDefault(); goToPage(page - 1); });
        pagination.appendChild(prev);
      } else {
        pagination.appendChild(document.createElement('span'));
      }

      const count = document.createElement('span');
      count.className = 'page-count';
      count.textContent = `Page ${page} of ${totalPages}`;
      pagination.appendChild(count);

      if (page < totalPages) {
        const next = document.createElement('a');
        next.className = 'btn';
        next.href = '#';
        next.textContent = 'Next →';
        next.addEventListener('click', (e) => { e.preventDefault(); goToPage(page + 1); });
        pagination.appendChild(next);
      } else {
        pagination.appendChild(document.createElement('span'));
      }
    }

    function renderBrowse(page, { updateUrl = true } = {}) {
      page = Math.min(Math.max(1, page), totalPages);
      results.replaceChildren();
      selectedIndex = -1;
      pagination.style.display = 'flex';
      showTabs();

      if (updateUrl) {
        history.replaceState(null, '', page > 1 ? `?page=${page}` : location.pathname);
      }

      status.textContent = `Showing ${sorted.length} songs`;

      const slice = sorted.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);
      for (const song of slice) results.appendChild(buildCard(song, '', page));

      renderPagination(page);
    }

    function goToPage(page) {
      window.scrollTo({ top: 0, behavior: 'smooth' });
      renderBrowse(page);
    }

    function renderSearch(query, { updateUrl = true } = {}) {
      results.replaceChildren();
      selectedIndex = -1;
      pagination.style.display = 'none';
      showTabs();
      markActiveTab('all');

      if (updateUrl) {
        history.replaceState(null, '', `?q=${encodeURIComponent(query)}`);
      }

      const q = query.toLowerCase();
      const matches = data.filter((song) => song.title.toLowerCase().includes(q) || song.lyrics.toLowerCase().includes(q));

      if (matches.length > 0) {
        status.textContent = `${matches.length} song${matches.length === 1 ? '' : 's'} found`;
        for (const song of matches) results.appendChild(buildCard(song, query));
        return;
      }

      const fuzzyMatches = fuzzyTitleMatches(query);
      if (fuzzyMatches.length > 0) {
        status.textContent = `No exact matches for "${query}". Showing songs with similar titles:`;
        for (const song of fuzzyMatches) results.appendChild(buildCard(song, ''));
        return;
      }

      status.textContent = 'No songs found. Try checking your spelling or using fewer words.';
    }

    input.addEventListener('input', (e) => {
      const query = e.target.value;
      if (query) {
        renderSearch(query);
      } else {
        history.replaceState(null, '', location.pathname);
        markActiveTab(currentTab);
        renderCurrentTab();
      }
    });

    function cardLink(li) {
      return li.querySelector('a');
    }

    function selectCard(index) {
      const cards = Array.from(results.children);
      if (cards.length === 0) return;
      const clamped = Math.max(0, Math.min(index, cards.length - 1));
      if (selectedIndex >= 0 && cards[selectedIndex]) {
        cardLink(cards[selectedIndex])?.classList.remove('selected');
      }
      selectedIndex = clamped;
      const link = cardLink(cards[selectedIndex]);
      link?.classList.add('selected');
      cards[selectedIndex].scrollIntoView({ block: 'nearest' });
    }

    function moveSelection(delta) {
      const cards = Array.from(results.children);
      if (cards.length === 0) return;
      const next = selectedIndex === -1 ? (delta > 0 ? 0 : cards.length - 1) : selectedIndex + delta;
      selectCard(next);
    }

    let statusResetTimeout = null;
    function showTransientStatus(message) {
      if (statusResetTimeout) clearTimeout(statusResetTimeout);
      const previous = status.textContent;
      status.textContent = message;
      statusResetTimeout = setTimeout(() => {
        status.textContent = previous;
        statusResetTimeout = null;
      }, 1500);
    }

    function toggleFavoriteById(songId) {
      const song = songById.get(songId);
      if (!song) return;
      const favs = getFavorites();
      const isFav = favs.includes(songId);
      setFavorites(isFav ? favs.filter((id) => id !== songId) : [...favs, songId]);
      showTransientStatus(`${isFav ? 'Removed' : 'Added'} "${song.title}" ${isFav ? 'from' : 'to'} favorites`);
      updateTabLabels();
    }

    document.addEventListener('keydown', (e) => {
      if (e.ctrlKey || e.metaKey || e.altKey) return;
      const typing = document.activeElement === input;

      if (e.key === '/' && !typing) {
        e.preventDefault();
        input.focus();
        input.select();
        return;
      }

      if (typing) {
        if (e.key === 'Escape') input.blur();
        return;
      }

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        moveSelection(1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        moveSelection(-1);
      } else if (e.key === 'Enter') {
        if (selectedIndex < 0) return;
        const cards = Array.from(results.children);
        const link = cardLink(cards[selectedIndex]);
        if (link) location.href = link.href;
      } else if (e.key === 'f' || e.key === 'F') {
        if (selectedIndex < 0) return;
        const cards = Array.from(results.children);
        const songId = cards[selectedIndex].dataset.songId;
        if (songId) toggleFavoriteById(songId);
      }
    });

    cachedPlaylists = getPlaylists();
    updateTabLabels();

    const params = new URLSearchParams(location.search);
    const initialQuery = params.get('q') || '';
    const initialPage = Math.max(1, parseInt(params.get('page'), 10) || 1);
    input.value = initialQuery;
    const initialTab = params.get('tab');
    if (initialQuery) {
      renderSearch(initialQuery, { updateUrl: false });
    } else if (['favorites', 'recent', 'set'].includes(initialTab)) {
      switchTab(initialTab);
    } else {
      renderBrowse(initialPage, { updateUrl: false });
    }
  </script>
</Layout>
