---
import Layout from '../../layouts/Layout.astro';
import { loadSongs } from '../../lib/songs-data.js';
import { parseLiveSetlist } from '../../lib/setlist.js';

export const prerender = false;

Astro.response.headers.set('Cache-Control', 'no-store');

const { id } = Astro.params;
const kv = Astro.locals.runtime.env.SETLISTS;
const liveSet = parseLiveSetlist(await kv.get(id));
const songs = await loadSongs(Astro.locals.runtime.env.SONGS_DATA);

let initialSongIds = [];
let initialName = 'Untitled Set';
if (liveSet) {
  initialSongIds = liveSet.songIds;
  initialName = liveSet.name || 'Untitled Set';
}

const songsJson = JSON.stringify(songs.map(({ id, slug, title, author, lyrics }) => ({ id, slug, title, author, lyrics })))
  .replace(/</g, '\\u003c');
const setInitJson = JSON.stringify({ setId: id, initialSongIds, initialName })
  .replace(/</g, '\\u003c');
---
<Layout title={liveSet === null ? 'Set List — Song Search' : `${initialName} — Song Search`} description="A shared, editable list of songs.">
  <div class="page">
    <p><a href="/?tab=set">← Back to Service Lists</a></p>

    {liveSet === null ? (
      <div>
        <h1>Set List Not Found</h1>
        <p class="status">This set list doesn't exist. It may have been mistyped, or the link is wrong.</p>
      </div>
    ) : (
      <div id="set-app">
        <h1>
          <span id="playlist-name">{initialName}</span>
          <input type="text" id="rename-input" class="input" value={initialName} hidden />
        </h1>
        <p class="list-date"><time id="list-date" class="badge" datetime={liveSet.createdAt ?? liveSet.updatedAt}></time></p>
        <div class="actions">
          <button id="rename-btn" class="btn">Rename</button>
          <button id="copy-link" class="btn btn-primary">Copy link</button>
          <button id="save-to-library" class="btn">Save to Service List</button>
          <button id="add-section" class="btn">Add section</button>
          <button id="delete-set" class="btn btn-danger">Delete</button>
        </div>
        <p id="status"></p>
        <ul id="set-songs"></ul>

        <h2>Add a song</h2>
        <input type="search" id="add-search" class="input" placeholder="Search by title or lyrics..." />
        <ul id="add-results"></ul>
      </div>
    )}
  </div>

  <style is:global>
    .status, #status {
      color: var(--color-muted-foreground);
      margin: var(--space-4) 0;
    }
    .list-date { margin: calc(var(--space-2) * -1) 0 var(--space-4); }
    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3);
      margin-bottom: var(--space-4);
    }
    #rename-input {
      font-family: 'Sora', ui-sans-serif, system-ui, sans-serif;
      font-weight: 800;
      font-size: var(--text-xl);
      max-width: 400px;
    }
    #set-songs, #add-results {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }
    .set-song .author {
      color: var(--color-muted-foreground);
      font-size: var(--text-sm);
    }
    .set-group { list-style: none; }
    .set-group > details > summary {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      list-style: none;
      cursor: pointer;
    }
    .set-group > details > summary::-webkit-details-marker { display: none; }
    .set-group > details > summary::before { content: '▸'; color: var(--color-muted-foreground); }
    .set-group > details[open] > summary::before { content: '▾'; }
    .set-group > details > summary > .set-section { flex: 1; }
    .set-group-songs {
      list-style: none;
      margin: var(--space-2) 0 0;
      padding: 0 0 0 var(--space-4);
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }
    .set-section {
      background: transparent;
      border-color: var(--color-border-strong);
      font-weight: 700;
      margin-top: var(--space-3);
    }
    #add-search { margin-top: var(--space-2); }
    #add-results .btn { width: 100%; justify-content: flex-start; font-weight: 500; }
  </style>

  <script type="application/json" id="songs-data" set:html={songsJson} />
  <script type="application/json" id="set-init-data" set:html={setInitJson} />
  <script>
    import { updateSetlist, deleteSetlist, isInLibrary, addPlaylistToLibrary, removePlaylistFromLibrary, updatePlaylistNameInLibrary } from '../../lib/setlist-client.js';
    import { isHeading, countSongs, addHeading, renameHeading, groupBySection } from '../../lib/sections.js';
    import { askSectionName, confirmDialog } from '../../lib/dialogs.js';
    import { formatListDate } from '../../lib/setlist.js';

    const setSongsList = document.getElementById('set-songs');

    if (setSongsList) {
      const data = JSON.parse(document.getElementById('songs-data').textContent);
      const songById = new Map(data.map((song) => [song.id, song]));
      const { setId, initialSongIds, initialName } = JSON.parse(document.getElementById('set-init-data').textContent);
      let currentIds = initialSongIds;
      let currentName = initialName;
      const statusEl = document.getElementById('status');
      const dateEl = document.getElementById('list-date');
      dateEl.textContent = formatListDate(dateEl.dateTime);

      const closedSections = new Set();

      function renderSetSongs() {
        setSongsList.replaceChildren();
        const songCount = countSongs(currentIds);
        if (songCount === 0) {
          statusEl.textContent = 'No songs in this set yet — add some below.';
        } else {
          statusEl.textContent = `${songCount} song${songCount === 1 ? '' : 's'} in this set`;
        }

        for (const group of groupBySection(currentIds)) {
          const rows = group.entries.map(({ item, index }) => buildSongRow(item, index)).filter(Boolean);
          if (!group.heading) {
            rows.forEach((row) => setSongsList.appendChild(row));
          } else {
            setSongsList.appendChild(buildSection(group, rows));
          }
        }
      }

      function buildSongRow(songId, index) {
        const song = songById.get(songId);
        if (!song) return null;

        const li = document.createElement('li');
        li.className = 'set-song row';

        const link = document.createElement('a');
        link.className = 'row-title';
        link.href = `/song/${song.slug}/?set=${encodeURIComponent(setId)}`;
        link.textContent = song.title;
        li.appendChild(link);

        if (song.author) {
          const author = document.createElement('span');
          author.className = 'author';
          author.textContent = song.author;
          li.appendChild(author);
        }

        const controls = document.createElement('span');
        controls.className = 'controls row-controls';

        const upBtn = document.createElement('button');
        upBtn.type = 'button';
        upBtn.className = 'btn btn-sm';
        upBtn.textContent = '↑';
        upBtn.disabled = index === 0;
        upBtn.addEventListener('click', () => reorder(index, -1));
        controls.appendChild(upBtn);

        const downBtn = document.createElement('button');
        downBtn.type = 'button';
        downBtn.className = 'btn btn-sm';
        downBtn.textContent = '↓';
        downBtn.disabled = index === currentIds.length - 1;
        downBtn.addEventListener('click', () => reorder(index, 1));
        controls.appendChild(downBtn);

        const removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'btn btn-sm btn-danger';
        removeBtn.textContent = 'Remove';
        removeBtn.addEventListener('click', () => removeAt(index));
        controls.appendChild(removeBtn);

        li.appendChild(controls);
        return li;
      }

      // A section header (click to open/close) with its songs underneath.
      // ponytail: closed state is remembered by section name, so duplicate names share it.
      function buildSection(group, rows) {
        const name = group.heading.section;
        const li = document.createElement('li');
        li.className = 'set-group';

        const details = document.createElement('details');
        details.open = !closedSections.has(name);
        details.addEventListener('toggle', () => {
          if (details.open) closedSections.delete(name);
          else closedSections.add(name);
        });

        const summary = document.createElement('summary');
        summary.appendChild(buildHeadingRow(group.heading, group.headingIndex, rows.length));
        details.appendChild(summary);

        const songs = document.createElement('ul');
        songs.className = 'set-group-songs';
        rows.forEach((row) => songs.appendChild(row));
        details.appendChild(songs);

        li.appendChild(details);
        return li;
      }

      function buildHeadingRow(heading, index, songCount) {
        const li = document.createElement('div');
        li.className = 'set-song set-section row';

        const title = document.createElement('span');
        title.textContent = `${heading.section} (${songCount})`;
        li.appendChild(title);

        const controls = document.createElement('span');
        controls.className = 'controls row-controls';

        const upBtn = document.createElement('button');
        upBtn.type = 'button';
        upBtn.className = 'btn btn-sm';
        upBtn.textContent = '↑';
        upBtn.disabled = index === 0;
        upBtn.addEventListener('click', () => reorder(index, -1));
        controls.appendChild(upBtn);

        const downBtn = document.createElement('button');
        downBtn.type = 'button';
        downBtn.className = 'btn btn-sm';
        downBtn.textContent = '↓';
        downBtn.disabled = index === currentIds.length - 1;
        downBtn.addEventListener('click', () => reorder(index, 1));
        controls.appendChild(downBtn);

        const renameBtn = document.createElement('button');
        renameBtn.type = 'button';
        renameBtn.className = 'btn btn-sm';
        renameBtn.textContent = 'Rename';
        renameBtn.addEventListener('click', async () => {
          const name = await askSectionName(heading.section);
          if (name) persist(renameHeading(currentIds, index, name));
        });
        controls.appendChild(renameBtn);

        const removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'btn btn-sm btn-danger';
        removeBtn.textContent = 'Remove';
        removeBtn.addEventListener('click', () => removeAt(index));
        controls.appendChild(removeBtn);

        li.appendChild(controls);
        return li;
      }

      async function persist(nextIds) {
        currentIds = nextIds;
        renderSetSongs();
        try {
          await updateSetlist(setId, currentIds);
        } catch (err) {
          statusEl.textContent = err.message || 'Could not save that change. Check your connection and try again.';
        }
      }

      function reorder(index, direction) {
        const target = index + direction;
        if (target < 0 || target >= currentIds.length) return;
        const next = [...currentIds];
        [next[index], next[target]] = [next[target], next[index]];
        persist(next);
      }

      function removeAt(index) {
        persist(currentIds.filter((_, i) => i !== index));
      }

      function addSong(songId) {
        if (currentIds.includes(songId)) return;
        // New songs land in the last section; make sure it is open so the song is visible.
        const lastHeading = [...currentIds].reverse().find(isHeading);
        if (lastHeading) closedSections.delete(lastHeading.section);
        persist([...currentIds, songId]);
      }

      renderSetSongs();

      document.getElementById('add-section').addEventListener('click', async () => {
        const name = await askSectionName();
        if (name) persist(addHeading(currentIds, name));
      });

      const nameSpan = document.getElementById('playlist-name');
      const renameInput = document.getElementById('rename-input');
      const renameBtn = document.getElementById('rename-btn');

      renameBtn.addEventListener('click', () => {
        if (renameInput.hidden) {
          renameInput.value = currentName;
          nameSpan.hidden = true;
          renameInput.hidden = false;
          renameInput.focus();
          renameInput.select();
          renameBtn.textContent = 'Save name';
          return;
        }

        const newName = renameInput.value.trim();
        if (!newName) {
          statusEl.textContent = 'A service list needs a name.';
          return;
        }
        renameBtn.disabled = true;
        updateSetlist(setId, currentIds, newName)
          .then(() => {
            currentName = newName;
            nameSpan.textContent = currentName;
            if (isInLibrary(setId)) updatePlaylistNameInLibrary(setId, currentName);
            document.title = `${currentName} — Song Search`;
            nameSpan.hidden = false;
            renameInput.hidden = true;
            renameBtn.textContent = 'Rename';
          })
          .catch((err) => {
            statusEl.textContent = err.message || 'Could not save the new name. Check your connection and try again.';
          })
          .finally(() => {
            renameBtn.disabled = false;
          });
      });

      const saveToLibraryBtn = document.getElementById('save-to-library');
      function updateSaveToLibraryButton() {
        if (isInLibrary(setId)) {
          saveToLibraryBtn.textContent = '✓ Saved';
          saveToLibraryBtn.disabled = true;
        } else {
          saveToLibraryBtn.textContent = 'Save to Service List';
          saveToLibraryBtn.disabled = false;
        }
      }
      updateSaveToLibraryButton();
      saveToLibraryBtn.addEventListener('click', () => {
        addPlaylistToLibrary(setId, currentName);
        updateSaveToLibraryButton();
      });

      document.getElementById('delete-set').addEventListener('click', async () => {
        if (!(await confirmDialog(`Delete "${currentName}" for everyone? This can't be undone from the site.`, { confirmLabel: 'Delete', danger: true }))) return;
        try {
          await deleteSetlist(setId);
          removePlaylistFromLibrary(setId);
          location.href = '/';
        } catch (err) {
          statusEl.textContent = err.message;
        }
      });

      const addInput = document.getElementById('add-search');
      const addResults = document.getElementById('add-results');
      addInput.addEventListener('input', (e) => {
        const q = e.target.value.trim().toLowerCase();
        addResults.replaceChildren();
        if (!q) return;
        const matches = data
          .filter((song) => !currentIds.includes(song.id) && (song.title.toLowerCase().includes(q) || song.lyrics.toLowerCase().includes(q)))
          .slice(0, 8);
        for (const song of matches) {
          const li = document.createElement('li');
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'btn';
          btn.textContent = `+ ${song.title}`;
          btn.addEventListener('click', () => {
            addSong(song.id);
            addInput.value = '';
            addResults.replaceChildren();
          });
          li.appendChild(btn);
          addResults.appendChild(li);
        }
      });

      const copyBtn = document.getElementById('copy-link');
      const defaultCopyText = copyBtn.textContent;
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          copyBtn.textContent = 'Copied!';
        } catch {
          copyBtn.textContent = 'Copy failed';
        }
        setTimeout(() => { copyBtn.textContent = defaultCopyText; }, 1500);
      });
    }
  </script>
</Layout>
