---
import Layout from '../../layouts/Layout.astro';
import { loadSongs } from '../../lib/songs-data.js';

export const prerender = false;

const songs = await loadSongs(Astro.locals.runtime.env.SONGS_DATA);
const song = songs.find((s) => s.slug === Astro.params.slug);

const LABEL_RE = /^\[?(verse|chorus|bridge|pre-?chorus|tag|ending|outro|intro|refrain|interlude)\s*\d*\]?:?$/i;

const stanzas = song
  ? song.lyrics.split(/\n\s*\n/).map((stanza) => stanza.split('\n').filter((line) => line.trim()))
  : [];

const firstLine = song ? stanzas.flat().find((line) => !LABEL_RE.test(line.trim())) ?? song.title : '';
const description = song
  ? (firstLine.length > 140 ? `${firstLine.slice(0, 140)}…` : firstLine)
  : undefined;
---
{!song ? (
  <Layout title="Song not found">
    <h1>Song not found</h1>
    <p>We couldn't find that song.</p>
    <p><a href="/">← Back to search</a></p>
  </Layout>
) : (
<Layout title={`${song.title} — Song Search`} description={description}>
  <div class="page">
    <p><a href="/" id="back-link">← Back to search</a></p>
    <h1>{song.title}</h1>
    {song.author && <p class="author">{song.author}</p>}

    <div class="lyrics card">
      {stanzas.map((lines) => (
        <div class="stanza">
          {lines.map((line) => (
            LABEL_RE.test(line.trim())
              ? <p class="label">{line.trim()}</p>
              : <p>{line}</p>
          ))}
        </div>
      ))}
    </div>

    <div class="actions">
      <button id="copy-link" class="btn btn-primary">Copy link</button>
      <button id="favorite-toggle" class="btn" aria-pressed="false">
        <span id="favorite-star">☆</span> Favorite
      </button>
      <button id="add-to-set" class="btn" data-song-id={song.id}>Add to List</button>
    </div>
  </div>

  <style>
    .author {
      color: var(--color-muted-foreground);
      font-style: italic;
      margin: 0 0 var(--space-5);
    }
    .lyrics {
      margin-bottom: var(--space-5);
      padding: var(--space-5) var(--space-6);
      font-size: var(--text-lg);
      line-height: 1.7;
    }
    .stanza { margin-bottom: var(--space-5); }
    .stanza:last-child { margin-bottom: 0; }
    .stanza p { margin: 0 0 2px; }
    .label {
      font-weight: 700;
      font-size: var(--text-xs);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-primary);
      margin-bottom: var(--space-2) !important;
    }
    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3);
    }
    #favorite-toggle[aria-pressed="true"] {
      background: var(--color-accent);
      color: var(--color-on-accent);
      border-color: var(--color-accent);
    }
    @media (max-width: 640px) {
      .lyrics { padding: var(--space-4); }
      .actions .btn { flex: 1 1 calc(50% - var(--space-3)); }
    }
  </style>

  <script define:vars={{ songId: song.id }}>
    const params = new URLSearchParams(location.search);
    const query = params.get('q');
    const page = params.get('page');
    const set = params.get('set');
    const backLink = document.getElementById('back-link');
    const FROM_TABS = { favorites: 'Favorites', recent: 'Recently Viewed', set: 'Service List' };
    if (set && /^[A-Za-z0-9]+$/.test(set)) {
      backLink.href = `/set/${set}/`;
      backLink.textContent = '← Back to service list';
      // Swap in the list's title once loaded; the generic text stays if the fetch fails.
      fetch(`/api/setlists/${set}`)
        .then((r) => (r.ok ? r.json() : null))
        .then((list) => { if (list?.name) backLink.textContent = `← Back to ${list.name}`; })
        .catch(() => {});
    } else if (FROM_TABS[params.get('from')]) {
      backLink.href = `/?tab=${params.get('from')}`;
      backLink.textContent = `← Back to ${FROM_TABS[params.get('from')]}`;
    } else if (query) {
      backLink.href = `/?q=${encodeURIComponent(query)}`;
    } else if (page) {
      backLink.href = `/?page=${encodeURIComponent(page)}`;
    }

    const btn = document.getElementById('copy-link');
    const defaultText = btn.textContent;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        btn.textContent = 'Copied!';
      } catch {
        btn.textContent = 'Copy failed';
      }
      setTimeout(() => { btn.textContent = defaultText; }, 1500);
    });

    function getFavorites() {
      try { return JSON.parse(localStorage.getItem('songSearchFavorites') || '[]'); }
      catch { return []; }
    }
    function setFavorites(ids) {
      try { localStorage.setItem('songSearchFavorites', JSON.stringify(ids)); } catch {}
    }
    const favBtn = document.getElementById('favorite-toggle');
    const favStar = document.getElementById('favorite-star');
    function updateFavButton(isFav) {
      favBtn.setAttribute('aria-pressed', String(isFav));
      favStar.textContent = isFav ? '★' : '☆';
    }
    updateFavButton(getFavorites().includes(songId));
    favBtn.addEventListener('click', () => {
      const favs = getFavorites();
      const isFav = favs.includes(songId);
      setFavorites(isFav ? favs.filter((x) => x !== songId) : [...favs, songId]);
      updateFavButton(!isFav);
    });
  </script>

  <script>
    import { addToDraft } from '../../lib/setlist-client.js';
    import { recordView } from '../../lib/recent.js';

    const addToSetBtn = document.getElementById('add-to-set');
    recordView(addToSetBtn.dataset.songId);
    const addToSetDefaultText = addToSetBtn.textContent;
    addToSetBtn.addEventListener('click', () => {
      addToDraft(addToSetBtn.dataset.songId);
      addToSetBtn.textContent = 'Added!';
      setTimeout(() => {
        addToSetBtn.textContent = addToSetDefaultText;
      }, 1500);
    });
  </script>
</Layout>
)}
